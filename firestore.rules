rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { allow read, write: if false; }

    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isValidUser(data) {
      return data.keys().hasAll(['role']) &&
             data.keys().size() <= 2 &&
             data.role in ['admin', 'staff', 'pengunjung'] &&
             (data.keys().hasAll(['email']) ? data.email is string : true);
    }

    function isValidSign(data) {
      return data.keys().hasAll(['imageUrl', 'locationId', 'updatedBy']) &&
             data.keys().size() == 3 &&
             data.imageUrl is string && data.imageUrl.size() <= 2000 &&
             data.locationId is string && data.locationId.size() <= 128 &&
             data.updatedBy is string && data.updatedBy == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && isValidId(userId) && userId == request.auth.uid && isValidUser(incoming()) && (incoming().role == 'pengunjung' || isAdmin());
      allow update: if isSignedIn() && isValidId(userId) && isValidUser(incoming()) && isAdmin();
    }

    match /signs/{signId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(signId) && isAdmin() && isValidSign(incoming());
      allow update: if isSignedIn() && isValidId(signId) && isAdmin() && isValidSign(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['imageUrl', 'locationId', 'updatedBy']);
      allow delete: if isAdmin();
    }
  }
}
